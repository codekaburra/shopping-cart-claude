# Copy to .env and fill in real values.

# SQLite file path. Local dev uses dev.db; production uses prod.db.
DATABASE_URL="file:./dev.db"

# HMAC key for signing session cookies (customer + admin).
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Admin dashboard login credentials.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Production only. The domain nginx should answer for — write it once:
#   DOMAIN="example.com"      -> serves example.com and www.example.com
#   DOMAIN="shop.example.com" -> subdomains are used as-is, no www added
# Space-separate to control the list yourself; it is then used verbatim.
# Leave unset to accept any hostname (plain-IP access). Required before running
# certbot for HTTPS. Applied by deploy/setup.sh — re-run it after changing.
DOMAIN=""
